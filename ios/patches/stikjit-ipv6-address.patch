diff --git a/Sources/DeviceSocketAddress.swift b/Sources/DeviceSocketAddress.swift
new file mode 100644
--- /dev/null
+++ b/Sources/DeviceSocketAddress.swift
@@ -0,0 +1,34 @@
+import Foundation
+import Darwin
+
+/// The socket address idevice's FFI connects to: Configuration.deviceAddress, an IPv4 or an IPv6
+/// numeric literal, with Configuration.rsdPort. idevice takes a sockaddr_in or a sockaddr_in6 and
+/// its length (util::c_socket_to_rust).
+enum DeviceSocketAddress {
+
+    static func make(address: String, port: UInt16) throws -> (storage: sockaddr_storage, length: socklen_t) {
+        var storage = sockaddr_storage()
+        var v4 = sockaddr_in()
+        if address.withCString({ inet_pton(AF_INET, $0, &v4.sin_addr) }) == 1 {
+            v4.sin_len = UInt8(MemoryLayout<sockaddr_in>.size)
+            v4.sin_family = sa_family_t(AF_INET)
+            v4.sin_port = port.bigEndian
+            withUnsafeMutableBytes(of: &storage) { target in
+                withUnsafeBytes(of: &v4) { target.copyMemory(from: $0) }
+            }
+            return (storage, socklen_t(MemoryLayout<sockaddr_in>.size))
+        }
+        var v6 = sockaddr_in6()
+        if address.withCString({ inet_pton(AF_INET6, $0, &v6.sin6_addr) }) == 1 {
+            v6.sin6_len = UInt8(MemoryLayout<sockaddr_in6>.size)
+            v6.sin6_family = sa_family_t(AF_INET6)
+            v6.sin6_port = port.bigEndian
+            withUnsafeMutableBytes(of: &storage) { target in
+                withUnsafeBytes(of: &v6) { target.copyMemory(from: $0) }
+            }
+            return (storage, socklen_t(MemoryLayout<sockaddr_in6>.size))
+        }
+        throw StikJITError.device(code: -1, subCode: 0,
+                                  message: "The device address \(address) is not an IPv4 or IPv6 address")
+    }
+}
