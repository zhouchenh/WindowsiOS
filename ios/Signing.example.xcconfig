// SPDX-License-Identifier: GPL-2.0-or-later
//
// Template for your personal signing settings:
//   cp ios/Signing.example.xcconfig ios/Signing.local.xcconfig
// then edit ios/Signing.local.xcconfig (it is gitignored). See docs/building.md.

// Your team id (10 characters). Xcode > Settings > Accounts shows your teams; a free
// "Personal Team" works. It is also the "OU" of your certificate:
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
DEVELOPMENT_TEAM = XXXXXXXXXX

// Any reverse-DNS id of your own. An id registered by another team cannot be used.
// Built-in JIT's helper extension (PlugIns/WinJITHelper.appex) gets this id plus ".JITHelper"
// (here com.example.applevm.duo.JITHelper; see WinJITHelper.xcconfig) and the same team and
// signing style. That is a second App ID: a free personal team can register 10 per 7 days, and
// Automatic signing registers both. Do not set the helper's id yourself.
PRODUCT_BUNDLE_IDENTIFIER = com.example.applevm.duo

// Let Xcode register the App ID and make the provisioning profile.
CODE_SIGN_STYLE = Automatic

// Paid Apple Developer Program teams only: lets the guest use more RAM and gives the
// app a larger address space (increased-memory-limit + extended-virtual-addressing).
// A free personal team cannot sign these; leave the line commented out.
// CODE_SIGN_ENTITLEMENTS = WindowsiOS-IncreasedMemory.entitlements
