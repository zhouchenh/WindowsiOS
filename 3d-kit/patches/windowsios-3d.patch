+    hv_pci_add_bar(&v->pci, 1, 0x1000, 0);
+    hv_pci_add_msix(&v->pci, 0x90, 1, 0x000, 0x800, nvec); /* after the 20-byte notify cap at 0x70 */
+    v->msix = 1;
+    v->config_vec = 0xffff;
+    for (int i = 0; i < HV_VIRTQ_MAX; i++) v->q_vec[i] = 0xffff;
