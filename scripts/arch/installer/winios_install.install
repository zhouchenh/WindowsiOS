#!/bin/bash
# mkinitcpio build hook: the WindowsiOS Arch installer's tools and files.
build() {
    local f
    map add_binary curl bsdtar sfdisk mkfs.fat mkfs.ext4 mke2fs blkid ip stat md5sum dd tr wc
    add_file /winios-src/install.sh /winios/install.sh 755
    while IFS= read -r -d '' f; do
        add_file "$f" "/winios/root/${f#/winios-src/root/}"
    done < <(find /winios-src/root -type f -print0)
    add_runscript
}

help() {
    echo "Runs the WindowsiOS Arch installer (/winios/install.sh) instead of booting a root file system."
}
