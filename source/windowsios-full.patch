@@ -0,0 +1,34 @@
+#!/bin/bash
+# Development helper for Arch on WindowsiOS: a root service that runs jobs the host puts in the app's
+# shared folder (http://10.0.2.4/linux_job.txt: an id line, then shell commands) and uploads the
+# output (linux_out.txt). The Linux counterpart of the Windows helper. Remove: systemctl disable --now winios-agent
+cat > /usr/local/bin/winios-agent <<'A'
+#!/bin/bash
+u=http://10.0.2.4
+last=$(curl -s --max-time 5 $u/linux_job.txt | head -1)
+while true; do
+    sleep 1.5
+    t=$(curl -s --max-time 5 $u/linux_job.txt) || continue
+    id=$(head -1 <<<"$t"); cmd=$(tail -n +2 <<<"$t")
+    if [ -n "$id" ] && [ "$id" != "$last" ] && [ -n "$cmd" ]; then
+        last=$id
+        out=$(timeout 1800 bash -c "$cmd" 2>&1)
+        printf '%s\n%s\n' "$id" "$out" | curl -s --max-time 30 -T - $u/linux_out.txt
+    fi
+done
+A
+chmod 755 /usr/local/bin/winios-agent
+cat > /etc/systemd/system/winios-agent.service <<'S'
+[Unit]
+Description=WindowsiOS host job runner
+After=network-online.target
+Wants=network-online.target
+[Service]
+ExecStart=/usr/local/bin/winios-agent
+Restart=always
+[Install]
+WantedBy=multi-user.target
+S
+systemctl daemon-reload
+systemctl enable --now winios-agent
+echo agent-ok
diff --git a/scripts/arch/angle_probe.py b/scripts/arch/angle_probe.py
new file mode 100644
index 0000000..0eeccb8
--- /dev/null
+++ b/scripts/arch/angle_probe.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+# Can Chrome's own ANGLE (libEGL/libGLESv2 in /opt/google/chrome) make an OpenGL ES context here, and
+# which? Tries each ANGLE back end, headless (device/surfaceless display, a pbuffer), ES 3.0 then 2.0.
+#   python3 angle_probe.py [vulkan|gl|gles|swiftshader ...]
+import ctypes, sys
+
+D = '/opt/google/chrome/'
+egl = ctypes.CDLL(D + 'libEGL.so', mode=ctypes.RTLD_GLOBAL)
+gles = ctypes.CDLL(D + 'libGLESv2.so', mode=ctypes.RTLD_GLOBAL)
+
+EGL_PLATFORM_ANGLE_ANGLE = 0x3202
+EGL_PLATFORM_ANGLE_TYPE_ANGLE = 0x3203
+TYPES = {'gl': 0x320D, 'gles': 0x320E, 'vulkan': 0x3450, 'swiftshader': 0x3450}
+EGL_PLATFORM_ANGLE_DEVICE_TYPE_ANGLE = 0x3209
+EGL_PLATFORM_ANGLE_DEVICE_TYPE_SWIFTSHADER_ANGLE = 0x3487
+EGL_NONE, EGL_TRUE = 0x3038, 1
+EGL_VENDOR, EGL_VERSION, EGL_EXTENSIONS = 0x3053, 0x3054, 0x3055
+EGL_SURFACE_TYPE, EGL_PBUFFER_BIT, EGL_RENDERABLE_TYPE = 0x3033, 0x0001, 0x3040
+EGL_OPENGL_ES2_BIT, EGL_OPENGL_ES3_BIT = 0x0004, 0x0040
+EGL_RED_SIZE, EGL_GREEN_SIZE, EGL_BLUE_SIZE = 0x3024, 0x3023, 0x3022
+EGL_WIDTH, EGL_HEIGHT = 0x3057, 0x3056
+EGL_CONTEXT_MAJOR_VERSION, EGL_CONTEXT_MINOR_VERSION = 0x3098, 0x30FB
+EGL_OPENGL_ES_API = 0x30A0
+GL_VENDOR, GL_RENDERER, GL_VERSION = 0x1F00, 0x1F01, 0x1F02
+
+egl.eglGetPlatformDisplayEXT.restype = ctypes.c_void_p
+egl.eglGetPlatformDisplayEXT.argtypes = [ctypes.c_uint, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
+egl.eglInitialize.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int)]
+egl.eglQueryString.restype = ctypes.c_char_p
+egl.eglQueryString.argtypes = [ctypes.c_void_p, ctypes.c_int]
+egl.eglChooseConfig.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_void_p),
+                                ctypes.c_int, ctypes.POINTER(ctypes.c_int)]
+egl.eglCreatePbufferSurface.restype = ctypes.c_void_p
+egl.eglCreatePbufferSurface.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
+egl.eglCreateContext.restype = ctypes.c_void_p
+egl.eglCreateContext.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
+egl.eglMakeCurrent.argtypes = [ctypes.c_void_p] * 4
+egl.eglTerminate.argtypes = [ctypes.c_void_p]
+gles.glGetString.restype = ctypes.c_char_p
+gles.glGetString.argtypes = [ctypes.c_uint]
+
+
+def arr(*v):
+    return (ctypes.c_int * len(v))(*v)
+
+
+def probe(name):
+    print(f'== ANGLE {name}')
+    a = [EGL_PLATFORM_ANGLE_TYPE_ANGLE, TYPES[name]]
+    if name == 'swiftshader':
+        a += [EGL_PLATFORM_ANGLE_DEVICE_TYPE_ANGLE, EGL_PLATFORM_ANGLE_DEVICE_TYPE_SWIFTSHADER_ANGLE]
+    dpy = egl.eglGetPlatformDisplayEXT(EGL_PLATFORM_ANGLE_ANGLE, None, arr(*a, EGL_NONE))
+    ma, mi = ctypes.c_int(), ctypes.c_int()
+    if not dpy or not egl.eglInitialize(dpy, ctypes.byref(ma), ctypes.byref(mi)):
+        print(f'   eglInitialize failed: {egl.eglGetError():#x}')
+        return
+    print('   EGL', egl.eglQueryString(dpy, EGL_VERSION).decode())
+    for major, bit in ((3, EGL_OPENGL_ES3_BIT), (2, EGL_OPENGL_ES2_BIT)):
+        cfg, n = ctypes.c_void_p(), ctypes.c_int()
+        egl.eglChooseConfig(dpy, arr(EGL_SURFACE_TYPE, EGL_PBUFFER_BIT, EGL_RENDERABLE_TYPE, bit, EGL_RED_SIZE, 8,
+                                     EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_NONE), ctypes.byref(cfg), 1, ctypes.byref(n))
+        if n.value < 1:
+            print(f'   ES{major}: no config')
+            continue
+        surf = egl.eglCreatePbufferSurface(dpy, cfg, arr(EGL_WIDTH, 64, EGL_HEIGHT, 64, EGL_NONE))
+        egl.eglBindAPI(EGL_OPENGL_ES_API)
+        ctx = egl.eglCreateContext(dpy, cfg, None, arr(EGL_CONTEXT_MAJOR_VERSION, major, EGL_NONE))
+        if not ctx:
+            print(f'   ES{major}: eglCreateContext failed {egl.eglGetError():#x}')
+            continue
+        egl.eglMakeCurrent(dpy, surf, surf, ctx)
+        print(f'   ES{major}: OK  {gles.glGetString(GL_VERSION).decode()}  |  {gles.glGetString(GL_RENDERER).decode()}')
+        break
+    egl.eglTerminate(dpy)
+
+
+for n in sys.argv[1:] or ['vulkan', 'gles', 'gl', 'swiftshader']:
+    try:
+        probe(n)
+    except Exception as e:
+        print('   error', e)
diff --git a/scripts/arch/cpubench.sh b/scripts/arch/cpubench.sh
new file mode 100644
index 0000000..7258db2
--- /dev/null
+++ b/scripts/arch/cpubench.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+# CPU micro benchmarks for the emulator (also runs on macOS for a native reference).
+# Each line: name seconds. Output also to /root/cpubench.txt when run as root in the guest.
+t() { local s=$(date +%s.%N 2>/dev/null || python3 -c 'import time;print(time.time())'); "$@" >/dev/null 2>&1; local e=$(date +%s.%N 2>/dev/null); awk "BEGIN{printf \"%.3f\", $e - $s}"; }
+T=${TMPDIR:-/tmp}
+head -c 33554432 /dev/urandom > $T/cb.rand 2>/dev/null
+seq 1 400000 > $T/cb.seq
+{
+echo "sha256_64MB $(t sh -c "cat $T/cb.rand $T/cb.rand | openssl dgst -sha256")"
+echo "gzip_32MB $(t sh -c "gzip -1 -c $T/cb.seq $T/cb.rand > /dev/null")"
+echo "sort_400k $(t sh -c "sort -R $T/cb.seq | sort -n > /dev/null")"
+echo "awk_loop $(t awk 'BEGIN{s=0;for(i=0;i<3000000;i++)s+=i%7;print s}')"
+echo "fork_exec_300 $(t sh -c 'for i in $(seq 300); do /bin/sh -c true; done')"
+echo "syscalls_dd $(t dd if=/dev/zero of=/dev/null bs=64 count=300000)"
+echo "pipe_256MB $(t sh -c 'head -c 268435456 /dev/zero | cat > /dev/null')"
+echo "mmap_touch $(t sh -c 'head -c 400000000 /dev/zero | tail -c 1')"
+} | tee $T/cpubench.out
+rm -f $T/cb.rand $T/cb.seq
diff --git a/scripts/arch/firstboot/winios-firstboot b/scripts/arch/firstboot/winios-firstboot
new file mode 100644
index 0000000..b035d5d
--- /dev/null
+++ b/scripts/arch/firstboot/winios-firstboot
@@ -0,0 +1,86 @@
+#!/bin/bash
+# WindowsiOS Arch Linux installer, stage 2: the installed system's first boot. Brings the system up to
+# date and installs the KDE Plasma desktop (Wayland, automatic login of user alarm) with the GPU drivers
+# (Mesa virgl for OpenGL, Venus for Vulkan), then turns itself off and restarts into the desktop.
+# Progress: the screen, /root/firstboot.log and the app (http://10.0.2.4/arch_install_status.txt).
+# Run again by hand: systemctl start winios-firstboot (it does nothing once /var/lib/winios/firstboot-done exists).
+exec > >(tee -a /root/firstboot.log /dev/tty1) 2>&1
+DONE=/var/lib/winios/firstboot-done
+[ -e $DONE ] && exit 0
+
+status() {
+    echo "[winios] $*"
+    echo "$*" > /run/winios-status
+    curl -s -m 5 -T /run/winios-status http://10.0.2.4/arch_install_status.txt >/dev/null 2>&1
+}
+
+fail() {
+    status "error $*"
+    exit 1
+}
+
+# pacman with a few tries: a mirror can be briefly out of step or slow
+pac() {
+    for i in 1 2 3; do
+        pacman "$@" && return 0
+        sleep 10
+        pacman -Syy >/dev/null 2>&1
+    done
+    return 1
+}
+
+for i in $(seq 60); do curl -s -m 3 -o /dev/null http://10.0.2.4/ && break; sleep 2; done
+status "76 preparing the package manager"
+pacman-key --init || fail "pacman-key --init"
+pacman-key --populate archlinuxarm || fail "pacman-key --populate"
+
+status "78 updating the system"
+pac -Syyu --noconfirm || fail "system update"
+
+status "84 installing the KDE Plasma desktop and the GPU drivers (the longest step)"
+pac -S --noconfirm --needed \
+    plasma-desktop plasma-workspace kwin sddm sddm-kcm konsole dolphin kscreen kinfocenter systemsettings \
+    plasma-pa plasma-nm networkmanager breeze breeze-gtk xdg-desktop-portal-kde xorg-xwayland \
+    mesa mesa-utils vulkan-virtio vulkan-tools vulkan-icd-loader \
+    noto-fonts noto-fonts-cjk noto-fonts-emoji || fail "installing the desktop"
+
+status "96 setting up the desktop"
+mkdir -p /etc/sddm.conf.d
+cat > /etc/sddm.conf.d/autologin.conf <<'EOF'
+[Autologin]
+User=alarm
+Session=plasma
+Relogin=false
+
+[General]
+DisplayServer=wayland
+EOF
+# The screen must not dim, blank or lock by itself: on the iPad that looks like a broken screen.
+install -d -o alarm -g alarm /home/alarm/.config
+cat > /home/alarm/.config/powerdevilrc <<'EOF'
+[AC][Display]
+DimDisplayWhenIdle=false
+TurnOffDisplayWhenIdle=false
+
+[AC][SuspendAndShutdown]
+AutoSuspendAction=0
+EOF
+cat > /home/alarm/.config/kscreenlockerrc <<'EOF'
+[Daemon]
+Autolock=false
+LockOnResume=false
+EOF
+chown alarm:alarm /home/alarm/.config/powerdevilrc /home/alarm/.config/kscreenlockerrc
+systemctl enable sddm
+# Plasma's network icon and the desktop programs ask NetworkManager whether they are online.
+systemctl disable systemd-networkd.socket systemd-networkd
+systemctl enable NetworkManager
+pacman -Scc --noconfirm >/dev/null 2>&1 # the downloaded packages: about 1 GB
+
+mkdir -p /var/lib/winios
+touch $DONE
+systemctl disable winios-firstboot
+status "100 done: starting the desktop"
+sync
+sleep 2
+systemctl reboot
