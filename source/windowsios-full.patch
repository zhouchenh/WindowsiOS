--- a/host/prof_ios.c
+++ b/host/prof_ios.c
@@ -26,6 +26,9 @@ static _Atomic int nthreads;
 static struct { uintptr_t off; uint32_t n; } slots[SLOTS];
 static uint64_t total, idle, jit, other_image, unknown;
 static uintptr_t image_base;
+static uint64_t t_total[MAX_THREADS], t_busy[MAX_THREADS], t_fail[MAX_THREADS]; /* per guest CPU thread */
+#define OSLOTS 256
+static struct { const char *name; uint32_t n; } oslots[OSLOTS]; /* samples in system libraries, by symbol */
 
 static void reg(void) {
     int i = atomic_fetch_add(&nthreads, 1);
@@ -34,7 +37,16 @@ static void reg(void) {
 
 static void count_host(uintptr_t pc) {
     Dl_info info;
-    if (!dladdr((void *)pc, &info) || (uintptr_t)info.dli_fbase != image_base) { other_image++; return; }
+    if (!dladdr((void *)pc, &info) || (uintptr_t)info.dli_fbase != image_base) {
+        other_image++;
+        const char *nm = info.dli_sname ? info.dli_sname : "?";
+        uint32_t oh = (uint32_t)(((uintptr_t)nm >> 3) * 2654435761u) % OSLOTS;
+        for (int k = 0; k < 32; k++, oh = (oh + 1) % OSLOTS) {
+            if (oslots[oh].name == nm) { oslots[oh].n++; break; }
+            if (!oslots[oh].n) { oslots[oh].name = nm, oslots[oh].n = 1; break; }
+        }
+        return;
+    }
     uintptr_t off = pc - image_base;
     uint32_t h = (uint32_t)((off >> 2) * 2654435761u) % SLOTS;
     for (int k = 0; k < 64; k++, h = (h + 1) % SLOTS) {
@@ -59,6 +71,20 @@ static void dump(void) {
             busy ? 100.0 * other_image / busy : 0, (unsigned long)image_base);
     for (int i = 0; i < 40 && sorted[i].n; i++)
         fprintf(stderr, "hvprof: %5.2f%% +%#lx\n", busy ? 100.0 * sorted[i].n / busy : 0, (unsigned long)sorted[i].off);
+    int nt = atomic_load(&nthreads);
+    fprintf(stderr, "hvprof: threads %d busy:", nt);
+    for (int i = 0; i < nt && i < MAX_THREADS; i++)
+        fprintf(stderr, " [%d] %.1f%%%s", i, t_total[i] ? 100.0 * t_busy[i] / t_total[i] : 0, t_fail[i] ? " (unreadable)" : "");
+    fprintf(stderr, "\n");
+    for (int r = 0; r < 12; r++) { /* the dozen most sampled system-library symbols */
+        int best = -1;
+        for (int i = 0; i < OSLOTS; i++) if (oslots[i].n && (best < 0 || oslots[i].n > oslots[best].n)) best = i;
+        if (best < 0) break;
+        fprintf(stderr, "hvprof: other %5.2f%% %s\n", busy ? 100.0 * oslots[best].n / busy : 0, oslots[best].name);
+        oslots[best].n = 0;
+    }
+    memset(oslots, 0, sizeof oslots);
+    memset(t_total, 0, sizeof t_total); memset(t_busy, 0, sizeof t_busy); memset(t_fail, 0, sizeof t_fail);
     memset(slots, 0, sizeof slots);
     total = idle = jit = other_image = unknown = 0;
 }
@@ -75,9 +101,10 @@ static void *sampler(void *unused) {
         for (int i = 0; i < n && i < MAX_THREADS; i++) {
             thread_basic_info_data_t ti;
             mach_msg_type_number_t ni = THREAD_BASIC_INFO_COUNT;
-            if (thread_info(threads[i], THREAD_BASIC_INFO, (thread_info_t)&ti, &ni) != KERN_SUCCESS) continue;
-            total++;
+            if (thread_info(threads[i], THREAD_BASIC_INFO, (thread_info_t)&ti, &ni) != KERN_SUCCESS) { t_fail[i]++; continue; }
+            total++; t_total[i]++;
             if (ti.run_state != TH_STATE_RUNNING) { idle++; continue; }
+            t_busy[i]++;
             arm_thread_state64_t st;
             mach_msg_type_number_t sn = ARM_THREAD_STATE64_COUNT;
             if (thread_get_state(threads[i], ARM_THREAD_STATE64, (thread_state_t)&st, &sn) != KERN_SUCCESS) { unknown++; continue; }
diff --git a/host/winvm.c b/host/winvm.c
index 04d4bc4..c874fab 100644
--- a/host/winvm.c
+++ b/host/winvm.c
@@ -81,7 +81,14 @@ static void on_ill(int sig, siginfo_t *info, void *ctx) {
     sigaction(sig, prior, NULL);
 }
 
+/* The iOS sampling profiler (host/prof_ios.c, HV_PROF_IOS): every guest CPU thread registers itself. */
+void (*hv_prof_register)(void);
+#if TARGET_OS_IPHONE
+void hv_prof_ios_start(void);
+#endif
+
 static void prepare_cpu_thread(void) {
+    if (hv_prof_register) hv_prof_register();
     static __thread int done;
     if (done) return;
     done = 1;
@@ -137,6 +144,14 @@ uint64_t hv_winvm_display_frames(void) {
     return fb ? hv_fb_metal_frames(fb) : 0;
 }
 
+int hv_winvm_gpu_status(char *buf, unsigned len) {
+    return hv_virtio_gpu_describe(board.gpu, buf, len);
+}
+
+void hv_winvm_set_preferred_display(uint32_t w, uint32_t h) {
+    hv_virtio_gpu_set_preferred(board.gpu, w, h);
+}
+
 int hv_winvm_save_png(const char *path) {
     HvFbDisplay *fb = atomic_load_explicit(&display_fb, memory_order_acquire);
     return fb ? hv_fb_save_png(fb, path) : -1;
@@ -260,11 +275,20 @@ static void join_secondaries(void) {
     }
 }
 
+void hv_winvm_set_paused(int paused) {
+    __atomic_store_n(&m.paused, paused ? 1 : 0, __ATOMIC_RELEASE);
+    if (paused) hv_machine_kick_all(&m);
+    else for (int i = 0; i < ncpus; i++) hv_cpu_wake(&cpus[i]);
+}
+
 void hv_winvm_flush_disks(void) {
     if (disk0.fd >= 0) hv_disk_sync(&disk0);
 }
 
 int hv_winvm_run_cpu0(void) {
+#if TARGET_OS_IPHONE
+    hv_prof_ios_start(); /* before the CPU threads start, so they all register */
+#endif
     prepare_cpu_thread();
     for (;;) {
         int r = hv_run(&cpus[0]);
@@ -299,6 +323,7 @@ int hv_winvm_run_cpu0(void) {
                 board.flash1->status = 0x80;
             }
             if (board.fb) board.fb->active = 0;
+            hv_virtio_gpu_reset(board.gpu);
             hv_winvirt_reset_cpu(&board);
             m.flush_pending = 1;
             spawn_secondaries();
@@ -347,6 +372,19 @@ void hv_winvm_power_button(void) {
     hv_winvirt_power_button(&board);
 }
 
+/* Bytes typed into the guest's serial console (Linux: its login on ttyAMA0). Waits while the
+   UART's receive FIFO is full; the guest drains it at its own pace. */
+void hv_winvm_serial_send(const char *bytes, size_t n) {
+    if (!board.uart) return;
+    for (size_t i = 0; i < n && !atomic_load_explicit(&stop_requested, memory_order_relaxed);) {
+        hv_dev_lock(&m);
+        int ok = hv_pl011_receive(board.uart, (uint8_t)bytes[i]);
+        hv_dev_unlock(&m);
+        if (ok) i++;
+        else usleep(2000);
+    }
+}
+
 void hv_winvm_key_hid(uint8_t usage, int down) {
     if (board.usb) hv_xhci_key(board.usb, usage, down);
 }
diff --git a/host/winvm.h b/host/winvm.h
index 8ccb2f9..7c8bd93 100644
--- a/host/winvm.h
+++ b/host/winvm.h
@@ -32,12 +32,22 @@ int hv_winvm_run_cpu0(void);
 void hv_winvm_stop(void);
 void hv_winvm_power_button(void);
 void hv_winvm_flush_disks(void);
+/* Stops every guest CPU where it is (1) or lets them go on (0). Devices keep running: what the
+   guest already queued is finished. */
+void hv_winvm_set_paused(int paused);
+/* Feeds bytes to the guest serial console (blocks while its FIFO is full). */
+void hv_winvm_serial_send(const char *bytes, size_t n);
 
 /* Display & screenshot hooks (any thread) */
 void hv_winvm_set_display_layer(void *ca_metal_layer);
 int hv_winvm_display_size(uint32_t *w, uint32_t *h);
 uint64_t hv_winvm_display_frames(void);
 int hv_winvm_save_png(const char *path);
+/* Preferred display mode for virtio-gpu (e.g. the iPad screen in points); the guest driver
+   is told through a display-change event. No-op without virtio-gpu. */
+void hv_winvm_set_preferred_display(uint32_t w, uint32_t h);
+/* virtio-gpu status line for diagnostics; returns -1 without virtio-gpu. */
+int hv_winvm_gpu_status(char *buf, unsigned len);
 
 /* Input hooks (any thread) */
 void hv_winvm_key_hid(uint8_t usage, int down);
