diff --git a/scripts/arch/provoking_layer/provoking_layer.c b/scripts/arch/provoking_layer/provoking_layer.c
new file mode 100644
index 0000000..f219db7
--- /dev/null
+++ b/scripts/arch/provoking_layer/provoking_layer.c
@@ -0,0 +1,308 @@
+/* VK_LAYER_WINIOS_provoking_vertex: tells Vulkan programs the device has VK_EXT_provoking_vertex with
+ * "last vertex" mode, which the iPad's Vulkan (Venus over MoltenVK, i.e. Metal) does not offer, and
+ * keeps the extension and its structures away from the real driver.
+ *
+ * Why: ANGLE (Chrome's OpenGL ES on Vulkan) gives no OpenGL ES 3.0 without it, and Chrome needs 3.0,
+ * so Chrome had no GPU acceleration at all. The price: flat-shaded values come from the first vertex of a
+ * primitive instead of the last. Chrome's own drawing (Skia) feeds flat values from per-instance data,
+ * the same for every vertex, so it does not notice; a WebGL page that relies on the last vertex would
+ * see different colours.
+ *
+ * An implicit layer enabled only by WINIOS_FAKE_PROVOKING_VERTEX=1 (the Chrome launcher sets it).
+ * Build: gcc -shared -fPIC -O2 -o libVkLayer_winios_provoking.so provoking_layer.c */
+#include <stdlib.h>
+#include <string.h>
+#include <vulkan/vk_layer.h>
+#include <vulkan/vulkan.h>
+
+#define EXPORT __attribute__((visibility("default")))
+
+typedef struct Inst {
+    VkInstance inst;
+    PFN_vkGetInstanceProcAddr gipa;
+    PFN_vkEnumerateDeviceExtensionProperties enum_ext;
+    PFN_vkGetPhysicalDeviceFeatures2 feat2, feat2khr;
+    PFN_vkGetPhysicalDeviceProperties2 prop2, prop2khr;
+    PFN_vkDestroyInstance destroy;
+    struct Inst *next;
+} Inst;
+
+typedef struct Dev {
+    VkDevice dev;
+    PFN_vkGetDeviceProcAddr gdpa;
+    PFN_vkCreateGraphicsPipelines create_gp;
+    PFN_vkDestroyDevice destroy;
+    struct Dev *next;
+} Dev;
+
+static Inst *insts;
+static Dev *devs;
+static Inst *last_inst; /* physical devices map to their instance by the loader's dispatch key */
+
+static void *key(const void *h) { return *(void **)h; }
+
+static Inst *inst_of(const void *h) {
+    for (Inst *i = insts; i; i = i->next)
+        if (key(i->inst) == key(h)) return i;
+    return last_inst;
+}
+
+static Dev *dev_of(VkDevice d) {
+    for (Dev *x = devs; x; x = x->next)
+        if (key(x->dev) == key(d)) return x;
+    return NULL;
+}
+
+static VkResult VKAPI_CALL l_CreateInstance(const VkInstanceCreateInfo *ci, const VkAllocationCallbacks *a,
+                                            VkInstance *out) {
+    VkLayerInstanceCreateInfo *lci = (VkLayerInstanceCreateInfo *)ci->pNext;
+    while (lci && !(lci->sType == VK_STRUCTURE_TYPE_LOADER_INSTANCE_CREATE_INFO && lci->function == VK_LAYER_LINK_INFO))
+        lci = (VkLayerInstanceCreateInfo *)lci->pNext;
+    if (!lci) return VK_ERROR_INITIALIZATION_FAILED;
+    PFN_vkGetInstanceProcAddr gipa = lci->u.pLayerInfo->pfnNextGetInstanceProcAddr;
+    lci->u.pLayerInfo = lci->u.pLayerInfo->pNext;
+    PFN_vkCreateInstance create = (PFN_vkCreateInstance)gipa(VK_NULL_HANDLE, "vkCreateInstance");
+    VkResult r = create(ci, a, out);
+    if (r != VK_SUCCESS) return r;
+    Inst *i = calloc(1, sizeof *i);
+    i->inst = *out;
+    i->gipa = gipa;
+    i->enum_ext = (PFN_vkEnumerateDeviceExtensionProperties)gipa(*out, "vkEnumerateDeviceExtensionProperties");
+    i->feat2 = (PFN_vkGetPhysicalDeviceFeatures2)gipa(*out, "vkGetPhysicalDeviceFeatures2");
+    i->feat2khr = (PFN_vkGetPhysicalDeviceFeatures2)gipa(*out, "vkGetPhysicalDeviceFeatures2KHR");
+    i->prop2 = (PFN_vkGetPhysicalDeviceProperties2)gipa(*out, "vkGetPhysicalDeviceProperties2");
+    i->prop2khr = (PFN_vkGetPhysicalDeviceProperties2)gipa(*out, "vkGetPhysicalDeviceProperties2KHR");
+    i->destroy = (PFN_vkDestroyInstance)gipa(*out, "vkDestroyInstance");
+    i->next = insts;
+    insts = i;
+    last_inst = i;
+    return VK_SUCCESS;
+}
+
+static void VKAPI_CALL l_DestroyInstance(VkInstance inst, const VkAllocationCallbacks *a) {
+    for (Inst **p = &insts; *p; p = &(*p)->next)
+        if ((*p)->inst == inst) {
+            Inst *i = *p;
+            *p = i->next;
+            if (last_inst == i) last_inst = insts;
+            i->destroy(inst, a);
+            free(i);
+            return;
+        }
+}
+
+static VkResult VKAPI_CALL l_EnumerateDeviceExtensionProperties(VkPhysicalDevice pd, const char *layer,
+                                                                uint32_t *count, VkExtensionProperties *props) {
+    if (layer && !strcmp(layer, "VK_LAYER_WINIOS_provoking_vertex")) {
+        if (!props) *count = 0;
+        return VK_SUCCESS;
+    }
+    Inst *i = inst_of(pd);
+    uint32_t n = 0;
+    VkResult r = i->enum_ext(pd, layer, &n, NULL);
+    if (r != VK_SUCCESS) return r;
+    VkExtensionProperties *all = calloc(n + 1, sizeof *all);
+    i->enum_ext(pd, layer, &n, all);
+    int have = 0;
+    for (uint32_t k = 0; k < n; k++)
+        if (!strcmp(all[k].extensionName, VK_EXT_PROVOKING_VERTEX_EXTENSION_NAME)) have = 1;
+    if (!have && !layer) {
+        strcpy(all[n].extensionName, VK_EXT_PROVOKING_VERTEX_EXTENSION_NAME);
+        all[n].specVersion = VK_EXT_PROVOKING_VERTEX_SPEC_VERSION;
+        n++;
+    }
+    if (!props) {
+        *count = n;
+    } else {
+        uint32_t c = *count < n ? *count : n;
+        memcpy(props, all, c * sizeof *all);
+        r = c < n ? VK_INCOMPLETE : VK_SUCCESS;
+        *count = c;
+    }
+    free(all);
+    return r;
+}
+
+static void fix_features(VkPhysicalDeviceFeatures2 *f) {
+    for (VkBaseOutStructure *s = (VkBaseOutStructure *)f->pNext; s; s = s->pNext)
+        if (s->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROVOKING_VERTEX_FEATURES_EXT) {
+            VkPhysicalDeviceProvokingVertexFeaturesEXT *p = (void *)s;
+            p->provokingVertexLast = VK_TRUE;
+            p->transformFeedbackPreservesProvokingVertex = VK_FALSE;
+        }
+}
+
+static void VKAPI_CALL l_GetPhysicalDeviceFeatures2(VkPhysicalDevice pd, VkPhysicalDeviceFeatures2 *f) {
+    Inst *i = inst_of(pd);
+    (i->feat2 ? i->feat2 : i->feat2khr)(pd, f);
+    fix_features(f);
+}
+
+static void VKAPI_CALL l_GetPhysicalDeviceFeatures2KHR(VkPhysicalDevice pd, VkPhysicalDeviceFeatures2 *f) {
+    Inst *i = inst_of(pd);
+    (i->feat2khr ? i->feat2khr : i->feat2)(pd, f);
+    fix_features(f);
+}
+
+static void fix_props(VkPhysicalDeviceProperties2 *p) {
+    for (VkBaseOutStructure *s = (VkBaseOutStructure *)p->pNext; s; s = s->pNext)
+        if (s->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROVOKING_VERTEX_PROPERTIES_EXT) {
+            VkPhysicalDeviceProvokingVertexPropertiesEXT *q = (void *)s;
+            q->provokingVertexModePerPipeline = VK_TRUE;
+            q->transformFeedbackPreservesTriangleFanProvokingVertex = VK_FALSE;
+        }
+}
+
+static void VKAPI_CALL l_GetPhysicalDeviceProperties2(VkPhysicalDevice pd, VkPhysicalDeviceProperties2 *p) {
+    Inst *i = inst_of(pd);
+    (i->prop2 ? i->prop2 : i->prop2khr)(pd, p);
+    fix_props(p);
+}
+
+static void VKAPI_CALL l_GetPhysicalDeviceProperties2KHR(VkPhysicalDevice pd, VkPhysicalDeviceProperties2 *p) {
+    Inst *i = inst_of(pd);
+    (i->prop2khr ? i->prop2khr : i->prop2)(pd, p);
+    fix_props(p);
+}
+
+typedef struct Patch {
+    VkBaseInStructure *at;
+    const VkBaseInStructure *was;
+} Patch;
+
+/* Remove structs of these types from a chain in place, remembering how to put them back. */
+static int unlink_types(const void **head, VkStructureType t1, VkStructureType t2, Patch *patches, int cap,
+                        const void **old_head) {
+    int n = 0;
+    *old_head = *head;
+    while (*head && (((const VkBaseInStructure *)*head)->sType == t1 || ((const VkBaseInStructure *)*head)->sType == t2))
+        *head = ((const VkBaseInStructure *)*head)->pNext;
+    for (VkBaseInStructure *s = (VkBaseInStructure *)*head; s && n < cap;) {
+        const VkBaseInStructure *nx = s->pNext;
+        if (nx && (nx->sType == t1 || nx->sType == t2)) {
+            patches[n].at = s;
+            patches[n].was = nx;
+            n++;
+            s->pNext = nx->pNext;
+            continue;
+        }
+        s = (VkBaseInStructure *)nx;
+    }
+    return n;
+}
+
+static void relink(Patch *patches, int n) {
+    while (n--) patches[n].at->pNext = patches[n].was;
+}
+
+static VkResult VKAPI_CALL l_CreateDevice(VkPhysicalDevice pd, const VkDeviceCreateInfo *ci,
+                                          const VkAllocationCallbacks *a, VkDevice *out) {
+    VkLayerDeviceCreateInfo *lci = (VkLayerDeviceCreateInfo *)ci->pNext;
+    while (lci && !(lci->sType == VK_STRUCTURE_TYPE_LOADER_DEVICE_CREATE_INFO && lci->function == VK_LAYER_LINK_INFO))
+        lci = (VkLayerDeviceCreateInfo *)lci->pNext;
+    if (!lci) return VK_ERROR_INITIALIZATION_FAILED;
+    PFN_vkGetInstanceProcAddr gipa = lci->u.pLayerInfo->pfnNextGetInstanceProcAddr;
+    PFN_vkGetDeviceProcAddr gdpa = lci->u.pLayerInfo->pfnNextGetDeviceProcAddr;
+    lci->u.pLayerInfo = lci->u.pLayerInfo->pNext;
+    Inst *in = inst_of(pd);
+    PFN_vkCreateDevice create = (PFN_vkCreateDevice)gipa(in->inst, "vkCreateDevice");
+
+    /* the extension and its feature struct never reach the driver */
+    VkDeviceCreateInfo c = *ci;
+    const char **names = calloc(ci->enabledExtensionCount + 1, sizeof *names);
+    uint32_t n = 0;
+    for (uint32_t k = 0; k < ci->enabledExtensionCount; k++)
+        if (strcmp(ci->ppEnabledExtensionNames[k], VK_EXT_PROVOKING_VERTEX_EXTENSION_NAME))
+            names[n++] = ci->ppEnabledExtensionNames[k];
+    c.enabledExtensionCount = n;
+    c.ppEnabledExtensionNames = names;
+    Patch patches[8];
+    const void *old;
+    int np = unlink_types(&c.pNext, VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROVOKING_VERTEX_FEATURES_EXT,
+                          VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROVOKING_VERTEX_FEATURES_EXT, patches, 8, &old);
+    VkResult r = create(pd, &c, a, out);
+    relink(patches, np);
+    free(names);
+    if (r != VK_SUCCESS) return r;
+    Dev *d = calloc(1, sizeof *d);
+    d->dev = *out;
+    d->gdpa = gdpa;
+    d->create_gp = (PFN_vkCreateGraphicsPipelines)gdpa(*out, "vkCreateGraphicsPipelines");
+    d->destroy = (PFN_vkDestroyDevice)gdpa(*out, "vkDestroyDevice");
+    d->next = devs;
+    devs = d;
+    return VK_SUCCESS;
+}
+
+static void VKAPI_CALL l_DestroyDevice(VkDevice dev, const VkAllocationCallbacks *a) {
+    for (Dev **p = &devs; *p; p = &(*p)->next)
+        if ((*p)->dev == dev) {
+            Dev *d = *p;
+            *p = d->next;
+            d->destroy(dev, a);
+            free(d);
+            return;
+        }
+}
+
+static VkResult VKAPI_CALL l_CreateGraphicsPipelines(VkDevice dev, VkPipelineCache cache, uint32_t count,
+                                                     const VkGraphicsPipelineCreateInfo *cis,
+                                                     const VkAllocationCallbacks *a, VkPipeline *out) {
+    Dev *d = dev_of(dev);
+    enum { MAXP = 64 };
+    Patch patches[MAXP];
+    const void *olds[MAXP];
+    VkPipelineRasterizationStateCreateInfo *rs[MAXP];
+    int np = 0, nr = 0;
+    for (uint32_t k = 0; k < count && nr < MAXP; k++) {
+        VkPipelineRasterizationStateCreateInfo *r = (VkPipelineRasterizationStateCreateInfo *)cis[k].pRasterizationState;
+        if (!r) continue;
+        rs[nr] = r;
+        np += unlink_types(&r->pNext, VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_PROVOKING_VERTEX_STATE_CREATE_INFO_EXT,
+                           VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_PROVOKING_VERTEX_STATE_CREATE_INFO_EXT,
+                           patches + np, MAXP - np, &olds[nr]);
+        nr++;
+    }
+    VkResult res = d->create_gp(dev, cache, count, cis, a, out);
+    relink(patches, np);
+    for (int k = 0; k < nr; k++) rs[k]->pNext = olds[k];
+    return res;
+}
+
+static PFN_vkVoidFunction VKAPI_CALL l_GetDeviceProcAddr(VkDevice dev, const char *name);
+
+static PFN_vkVoidFunction own(const char *name) {
+#define F(n) if (!strcmp(name, "vk" #n)) return (PFN_vkVoidFunction)l_##n;
+    F(CreateInstance) F(DestroyInstance) F(EnumerateDeviceExtensionProperties) F(GetPhysicalDeviceFeatures2)
+    F(GetPhysicalDeviceFeatures2KHR) F(GetPhysicalDeviceProperties2) F(GetPhysicalDeviceProperties2KHR)
+    F(CreateDevice) F(DestroyDevice) F(CreateGraphicsPipelines) F(GetDeviceProcAddr)
+#undef F
+    return NULL;
+}
+
+EXPORT PFN_vkVoidFunction VKAPI_CALL l_GetInstanceProcAddr(VkInstance inst, const char *name);
+
+static PFN_vkVoidFunction VKAPI_CALL l_GetDeviceProcAddr(VkDevice dev, const char *name) {
+    if (!strcmp(name, "vkGetDeviceProcAddr")) return (PFN_vkVoidFunction)l_GetDeviceProcAddr;
+    if (!strcmp(name, "vkDestroyDevice")) return (PFN_vkVoidFunction)l_DestroyDevice;
+    if (!strcmp(name, "vkCreateGraphicsPipelines")) return (PFN_vkVoidFunction)l_CreateGraphicsPipelines;
+    Dev *d = dev_of(dev);
+    return d ? d->gdpa(dev, name) : NULL;
+}
+
+EXPORT PFN_vkVoidFunction VKAPI_CALL l_GetInstanceProcAddr(VkInstance inst, const char *name) {
+    if (!strcmp(name, "vkGetInstanceProcAddr")) return (PFN_vkVoidFunction)l_GetInstanceProcAddr;
+    PFN_vkVoidFunction f = own(name);
+    if (f) return f;
+    if (!inst) return NULL;
+    Inst *i = inst_of(inst);
+    return i ? i->gipa(inst, name) : NULL;
+}
+
+EXPORT VkResult VKAPI_CALL vkNegotiateLoaderLayerInterfaceVersion(VkNegotiateLayerInterface *v) {
+    if (v->loaderLayerInterfaceVersion > 2) v->loaderLayerInterfaceVersion = 2;
+    v->pfnGetInstanceProcAddr = l_GetInstanceProcAddr;
+    v->pfnGetDeviceProcAddr = l_GetDeviceProcAddr;
+    v->pfnGetPhysicalDeviceProcAddr = NULL;
+    return VK_SUCCESS;
+}
diff --git a/scripts/arch/setup_plasma.sh b/scripts/arch/setup_plasma.sh
new file mode 100644
index 0000000..68dd6cb
--- /dev/null
+++ b/scripts/arch/setup_plasma.sh
@@ -0,0 +1,37 @@
+#!/bin/bash
+# Arch Linux ARM on WindowsiOS: updates the system and installs KDE Plasma (Wayland) with Mesa's
+# virgl driver, and an automatic login of user alarm into Plasma. Log: /root/setup.log
+#   curl -s http://10.0.2.4/setup_plasma.sh | bash
+set -x
+exec > >(tee -a /root/setup.log) 2>&1
+echo "=== start $(date)"
+# one consistent mirror set (the geo-redirecting default served a database ahead of its files)
+cat > /etc/pacman.d/mirrorlist <<'ML'
+Server = http://ca.us.mirror.archlinuxarm.org/$arch/$repo
+Server = http://dk.mirror.archlinuxarm.org/$arch/$repo
+Server = http://fl.us.mirror.archlinuxarm.org/$arch/$repo
+ML
+pacman-key --init
+pacman-key --populate archlinuxarm
+pacman -Syyu --noconfirm
+pacman -S --noconfirm --needed \
+    plasma-desktop plasma-workspace kwin sddm sddm-kcm konsole dolphin kscreen kinfocenter \
+    plasma-pa plasma-nm breeze breeze-gtk xdg-desktop-portal-kde xorg-xwayland \
+    mesa mesa-utils vulkan-tools noto-fonts
+mkdir -p /etc/sddm.conf.d
+cat > /etc/sddm.conf.d/autologin.conf <<'CONF'
+[Autologin]
+User=alarm
+Session=plasma
+Relogin=false
+
+[General]
+DisplayServer=wayland
+CONF
+systemctl enable sddm
+# The network: NetworkManager instead of the base image's systemd-networkd. Plasma's network icon and
+# the desktop programs that ask whether they are online go by NetworkManager, and showed "no network"
+# while networkd ran it. Takes over at the next boot (switching now would cut this session's link).
+systemctl disable systemd-networkd.socket systemd-networkd
+systemctl enable NetworkManager
+echo "=== done $(date)"
diff --git a/scripts/arch/startbench.sh b/scripts/arch/startbench.sh
new file mode 100644
index 0000000..4da29fc
--- /dev/null
+++ b/scripts/arch/startbench.sh
@@ -0,0 +1,9 @@
+#!/bin/bash
+# Process start-up cost of KDE/Qt programs: 20 runs each, total seconds.
+U=alarm; ID=$(id -u $U)
+r() { runuser -u $U -- env XDG_RUNTIME_DIR=/run/user/$ID QT_QPA_PLATFORM=offscreen "$@" >/dev/null 2>&1; }
+for c in "kreadconfig6 --file kdeglobals --group General --key ColorScheme" "dolphin --version" "python3 -c pass" "pacman -Q linux-aarch64"; do
+    set -- $c; which $1 >/dev/null 2>&1 || continue
+    s=$(date +%s.%N); for i in $(seq 20); do r $c; done; e=$(date +%s.%N)
+    awk "BEGIN{printf \"%-14s x20 %.2f s\n\", \"$1\", $e-$s}"
+done
diff --git a/scripts/arch_dev.sh b/scripts/arch_dev.sh
new file mode 100644
index 0000000..1a11ba3
--- /dev/null
+++ b/scripts/arch_dev.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+# Arch Linux bring-up on the iPad (development helper):
+#   arch_dev.sh boot [extra launch args]    restart the app on Arch with JIT
+#   arch_dev.sh sh 'command'                type a command into the serial console, print new log output
+#   arch_dev.sh log [n]                     last n lines of the guest log
+#   arch_dev.sh shot name.png               screenshot of the guest screen
+U=YOUR_IPAD_UDID; B=your.bundle.id; CORE=YOUR_COREDEVICE_ID
+D=${ARCH_DEV_DIR:-/tmp/archdev}; mkdir -p "$D"
+pull() { rm -f "$D/$2"; xcrun devicectl device copy from --device $U --domain-type appDataContainer --domain-identifier $B --source "$1" --destination "$D/$2" >/dev/null 2>&1; }
+push() { xcrun devicectl device copy to --device $U --domain-type appDataContainer --domain-identifier $B --source "$1" --destination "$2" >/dev/null 2>&1; }
+case "$1" in
+boot)
+    shift
+    ENVJ=${ARCH_ENV:-'{"MTL_DEBUG_LAYER":"0"}'}
+    (xcrun devicectl device process launch --device $U --console --start-stopped --terminate-existing --environment-variables "$ENVJ" -- $B -winios.autoStart YES -winios.machine Arch "$@" > "$D/console.log" 2>&1 &)
+    sleep 7; PID=$(xcrun devicectl device info processes --device $U 2>/dev/null | grep WindowsiOS.app/WindowsiOS | awk '{print $1}')
+    lldb -b -o 'script lldb.debugger.SetAsync(False)' -o "device select $CORE" -o "device process attach -p $PID" \
+        -o "command script import $(dirname "$0")/_lldb_txm_jit.py" -o 'txm_jit_run' > "$D/lldb.log" 2>&1
+    tail -1 "$D/lldb.log" | cut -c1-70 ;;
+sh)
+    pull Documents/winvm.log before.log; n=$(wc -l < "$D/before.log" 2>/dev/null || echo 0)
+    printf '%s\r' "$2" > "$D/serial.in"; push "$D/serial.in" Documents/serial.in
+    sleep "${3:-8}"; pull Documents/winvm.log after.log; tail -n +$((n + 1)) "$D/after.log" ;;
+log)
+    pull Documents/winvm.log winvm.log; tail -n "${2:-40}" "$D/winvm.log" ;;
+shot)
+    echo 1 > "$D/req"; push "$D/req" Documents/screenshot.request; sleep 11; pull Documents/latest_screen.png "$2"; echo "$D/$2" ;;
+esac
diff --git a/scripts/arch_job.sh b/scripts/arch_job.sh
new file mode 100644
index 0000000..66fcbb8
--- /dev/null
+++ b/scripts/arch_job.sh
@@ -0,0 +1,16 @@
+#!/bin/bash
+# Runs shell commands in the Arch guest through its winios-agent and prints the output.
+#   arch_job.sh 'commands' [timeout seconds]
+U=YOUR_IPAD_UDID; B=your.bundle.id
+D=${ARCH_DEV_DIR:-/tmp/archdev}; mkdir -p "$D"
+id=$(uuidgen); printf '%s\n%s\n' "$id" "$1" > "$D/job.txt"; : > "$D/empty"
+xcrun devicectl device copy to --device $U --domain-type appDataContainer --domain-identifier $B --source "$D/empty" --destination Documents/Shared/linux_out.txt >/dev/null 2>&1
+xcrun devicectl device copy to --device $U --domain-type appDataContainer --domain-identifier $B --source "$D/job.txt" --destination Documents/Shared/linux_job.txt >/dev/null 2>&1
+end=$((SECONDS + ${2:-120}))
+while [ $SECONDS -lt $end ]; do
+    sleep 4
+    rm -f "$D/out.txt"
+    xcrun devicectl device copy from --device $U --domain-type appDataContainer --domain-identifier $B --source Documents/Shared/linux_out.txt --destination "$D/out.txt" >/dev/null 2>&1
+    if [ "$(head -1 "$D/out.txt" 2>/dev/null)" = "$id" ]; then tail -n +2 "$D/out.txt"; exit 0; fi
+done
+echo "(no answer within ${2:-120}s)"; exit 1
diff --git a/scripts/bench/bench.ps1 b/scripts/bench/bench.ps1
new file mode 100644
index 0000000..89073db
--- /dev/null
+++ b/scripts/bench/bench.ps1
@@ -0,0 +1,67 @@
+# Guest side of the automatic smoothness test: moves a window around for a while, one step per
+# composed frame, and reports how many frames Windows composed and how busy each CPU was.
+# Started by the host script (scripts/bench/bench_device.py) through the app's typing channel:
+#   powershell -ExecutionPolicy Bypass -c "irm http://10.0.2.4/bench.ps1 | iex"
+$ErrorActionPreference = 'Continue'
+$hostUrl = 'http://10.0.2.4'
+$tag = 'run'; $seconds = 30
+try { $cfg = (Invoke-RestMethod "$hostUrl/bench_cfg.txt").Trim() -split '\s+'; $tag = $cfg[0]; if ($cfg.Count -gt 1) { $seconds = [int]$cfg[1] } } catch {}
+Add-Type -AssemblyName System.Windows.Forms, System.Drawing
+Add-Type @'
+using System; using System.Runtime.InteropServices;
+public static class BenchNative {
+    [DllImport("dwmapi.dll")] public static extern int DwmFlush();
+    [DllImport("dwmapi.dll")] public static extern int DwmGetCompositionTimingInfo(IntPtr hwnd, byte[] info);
+    [DllImport("user32.dll")] public static extern bool SetWindowPos(IntPtr h, IntPtr after, int x, int y, int cx, int cy, uint flags);
+    // DWM_TIMING_INFO (packed): cRefresh at 36, cFrame at 56; rateRefresh numerator/denominator at 4/8.
+    public static bool Timing(out ulong refresh, out ulong frame, out double hz) {
+        byte[] b = new byte[400]; BitConverter.GetBytes((uint)304).CopyTo(b, 0); refresh = frame = 0; hz = 0;
+        if (DwmGetCompositionTimingInfo(IntPtr.Zero, b) != 0) return false;
+        refresh = BitConverter.ToUInt64(b, 36); frame = BitConverter.ToUInt64(b, 56);
+        uint n = BitConverter.ToUInt32(b, 4), d = BitConverter.ToUInt32(b, 8); hz = d != 0 ? (double)n / d : 0;
+        return true;
+    }
+}
+'@
+$out = New-Object System.Collections.Generic.List[string]
+$out.Add("tag=$tag"); $out.Add("seconds=$seconds"); $out.Add("started=" + (Get-Date -Format s))
+$scr = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds
+$out.Add("screen=$($scr.Width)x$($scr.Height)")
+$form = New-Object System.Windows.Forms.Form
+$form.Text = 'WindowsiOS bench'; $form.StartPosition = 'Manual'
+$form.Width = [Math]::Min(900, [int]($scr.Width * 0.6)); $form.Height = [Math]::Min(600, [int]($scr.Height * 0.6))
+$tb = New-Object System.Windows.Forms.TextBox; $tb.Multiline = $true; $tb.Dock = 'Fill'
+$tb.Text = ("The quick brown fox jumps over the lazy dog. " * 60); $form.Controls.Add($tb)
+$form.TopMost = $true; $form.Show(); [System.Windows.Forms.Application]::DoEvents()
+$ncpu = [Environment]::ProcessorCount
+$pc = @(); for ($i = 0; $i -lt $ncpu; $i++) { $c = New-Object System.Diagnostics.PerformanceCounter('Processor', '% Processor Time', "$i"); [void]$c.NextValue(); $pc += $c }
+$names = 'dwm', 'explorer', 'csrss', 'System'
+$before = @{}; foreach ($n in $names) { $before[$n] = (Get-Process -Name $n -ErrorAction SilentlyContinue | Measure-Object -Property CPU -Sum).Sum }
+$me = [System.Diagnostics.Process]::GetCurrentProcess(); $meBefore = $me.TotalProcessorTime.TotalSeconds
+$r0 = [uint64]0; $f0 = [uint64]0; $hz = 0.0; $haveT = [BenchNative]::Timing([ref]$r0, [ref]$f0, [ref]$hz)
+$rx = [Math]::Max(1, ($scr.Width - $form.Width) / 2 - 10); $ry = [Math]::Max(1, ($scr.Height - $form.Height) / 2 - 30)
+$sw = [System.Diagnostics.Stopwatch]::StartNew(); $steps = 0; $worst = 0.0; $last = 0.0; $late = 0
+while ($sw.Elapsed.TotalSeconds -lt $seconds) {
+    $t = $sw.Elapsed.TotalSeconds
+    $x = [int]($rx + $rx * [Math]::Sin($t * 2.0)); $y = [int]($ry + $ry * [Math]::Cos($t * 1.3))
+    [void][BenchNative]::SetWindowPos($form.Handle, [IntPtr]::Zero, $x, $y, 0, 0, 0x0015)   # no size, no z-order, no activate
+    [System.Windows.Forms.Application]::DoEvents()
+    [void][BenchNative]::DwmFlush()                                                           # until the next composed frame
+    $now = $sw.Elapsed.TotalMilliseconds; $dt = $now - $last; $last = $now
+    if ($steps -gt 0) { if ($dt -gt $worst) { $worst = $dt }; if ($dt -gt 25) { $late++ } }
+    $steps++
+}
+$el = $sw.Elapsed.TotalSeconds
+$r1 = [uint64]0; $f1 = [uint64]0; [void][BenchNative]::Timing([ref]$r1, [ref]$f1, [ref]$hz)
+$out.Add(('steps_per_s={0:F1}' -f ($steps / $el)))
+$out.Add(('worst_step_ms={0:F0}' -f $worst)); $out.Add("steps_over_25ms=$late")
+if ($haveT) { $out.Add(('dwm_refresh_hz={0:F1}' -f $hz)); $out.Add(('dwm_refreshes_per_s={0:F1}' -f (($r1 - $r0) / $el))); $out.Add(('dwm_frames_per_s={0:F1}' -f (($f1 - $f0) / $el))) }
+$cpu = @(); foreach ($c in $pc) { $cpu += ('{0:F0}' -f $c.NextValue()) }
+$out.Add('cpu_pct=' + ($cpu -join ','))
+foreach ($n in $names) { $a = (Get-Process -Name $n -ErrorAction SilentlyContinue | Measure-Object -Property CPU -Sum).Sum; $out.Add(('proc_{0}_pct={1:F0}' -f $n, (100 * ($a - $before[$n]) / $el))) }
+$out.Add(('proc_bench_pct={0:F0}' -f (100 * ($me.TotalProcessorTime.TotalSeconds - $meBefore) / $el)))
+try { $g = Get-CimInstance Win32_VideoController | Select-Object -First 1; $out.Add("gpu=$($g.Name)"); $out.Add("mode=$($g.CurrentHorizontalResolution)x$($g.CurrentVerticalResolution)@$($g.CurrentRefreshRate)") } catch {}
+$out.Add("finished=" + (Get-Date -Format s))
+$form.Close()
+$p = Join-Path $env:TEMP 'bench_result.txt'; $out | Out-File -Encoding ascii $p
+try { Invoke-WebRequest -UseBasicParsing -Method Put -Uri "$hostUrl/bench_result.txt" -InFile $p | Out-Null } catch {}
diff --git a/scripts/bench/bench_device.py b/scripts/bench/bench_device.py
new file mode 100644
index 0000000..45c5cf9
--- /dev/null
+++ b/scripts/bench/bench_device.py
@@ -0,0 +1,220 @@
+#!/usr/bin/env python3
+"""Automatic smoothness test on a connected iPad/iPhone (direct install, not LiveContainer).
+
+For every configuration: restart the app with that setting, enable JIT through LLDB, let Windows
+start by itself, run the in-guest benchmark (bench.ps1 moves a window for N seconds), and collect
+  - guest side: frames Windows composed per second, worst frame gap, per-CPU load, per-process load
+  - host side:  frames the app put on screen per second, engine statistics, where host CPU time went
+Nothing is changed for good: settings are passed as launch arguments and environment variables.
+
+  python3 scripts/bench/bench_device.py                 # the default matrix
+  python3 scripts/bench/bench_device.py --only baseline # one configuration
+The device must be unlocked; Windows must already be set up with the 3D driver and network.
+"""
+import argparse, collections, json, os, re, subprocess, sys, time
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+CONFIGS = [
+    # tag, what it is, environment, launch arguments (NSUserDefaults overrides)
+    ("baseline", "默认：3D 开，HiDPI 关，JIT 缓存 768 MB，内存 8 GB", {}, []),
+    ("hidpi", "HiDPI 开", {}, ["-winios.hiDPIDisplay", "YES"]),
+    ("jit256", "JIT 缓存 256 MB", {}, ["-winios.jitMB", "256"]),
+    ("ram4g", "内存 4 GB", {}, ["-winios.ramMB", "4096"]),
+    ("nospin", "等中断时不空转 (HV_WFI_SPIN=0)", {"HV_WFI_SPIN": "0"}, []),
+]
+
+
+def run(cmd, timeout=None, check=False):
+    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, check=check)
+
+
+class Device:
+    def __init__(self, a):
+        self.udid, self.core, self.bundle, self.out = a.udid, a.coredevice, a.bundle, a.out
+
+    def dc(self, *args, timeout=120):
+        return run(["xcrun", "devicectl", "device", *args, "--device", self.udid], timeout=timeout)
+
+    def push(self, src, dst):
+        r = self.dc("copy", "to", "--domain-type", "appDataContainer", "--domain-identifier", self.bundle,
+                    "--source", src, "--destination", dst)
+        return "File Size" in r.stdout
+
+    def pull(self, src, dst):
+        if os.path.exists(dst): os.unlink(dst)
+        self.dc("copy", "from", "--domain-type", "appDataContainer", "--domain-identifier", self.bundle,
+                "--source", src, "--destination", dst)
+        return open(dst, errors="replace").read() if os.path.exists(dst) else ""
+
+    def push_text(self, text, dst):
+        p = os.path.join(self.out, "_tmp_push")
+        open(p, "w").write(text)
+        return self.push(p, dst)
+
+    def pid(self):
+        r = self.dc("info", "processes")
+        for line in r.stdout.splitlines():
+            if "WindowsiOS.app/WindowsiOS" in line: return int(line.split()[0])
+        return None
+
+    def status(self):
+        t = self.pull("Documents/boot_status.txt", os.path.join(self.out, "_status.txt"))
+        g = lambda k, d=None: (re.search(k + r"[:=] ?([\w.]+)", t) or [None, d])[1]
+        return {"raw": t, "uptime": float(g("uptime_sec", 0) or 0), "frames": int(g("frames_presented", 0) or 0),
+                "running": g("vm_running") == "true", "stage": g("stage"), "kbd": g("usb_kbd_ready") == "1",
+                "idle": float(g("wfi_idle_pct", 0) or 0), "jit_used": float(g("jit_used_mb", 0) or 0),
+                "flushes": int(g("jit_full_flushes", 0) or 0), "ram": g("ram_mb"), "three_d": g("3d"),
+                "scanout": (re.search(r"scanout=\d+ (\S+)", t) or [None, None])[1]}
+
+
+def start_app(dev, tag, env, args, log):
+    env = dict({"HV_STATS": "10", "HV_PROF_IOS": "1", "HV_PROF_IOS_SECS": "10", "WINIOS_CONSOLE": "1"}, **env)
+    console = open(os.path.join(dev.out, f"{tag}.console.log"), "w")
+    cmd = ["xcrun", "devicectl", "device", "process", "launch", "--device", dev.udid, "--console", "--start-stopped",
+           "--terminate-existing", "--environment-variables", json.dumps(env), "--", dev.bundle,
+           "-winios.autoStart", "YES", *args]
+    proc = subprocess.Popen(cmd, stdout=console, stderr=subprocess.STDOUT)
+    pid = None
+    for _ in range(15):
+        time.sleep(2)
+        pid = dev.pid()
+        if pid or proc.poll() is not None: break
+    if not pid:
+        raise RuntimeError("the app did not start (is the device unlocked?): see " + console.name)
+    log(f"  app started (pid {pid}); enabling JIT, about 2 minutes")
+    r = run(["lldb", "-b", "-o", "script lldb.debugger.SetAsync(False)", "-o", f"device select {dev.core}",
+             "-o", f"device process attach -p {pid}",
+             "-o", f"command script import {ROOT}/scripts/_lldb_txm_jit.py", "-o", "txm_jit_run"], timeout=420)
+    open(os.path.join(dev.out, f"{tag}.lldb.log"), "w").write(r.stdout + r.stderr)
+    if "SUCCESS" not in r.stdout: raise RuntimeError("JIT was not enabled: see " + tag + ".lldb.log")
+    return proc, console.name
+
+
+def wait_desktop(dev, log, timeout=300):
+    t0 = time.time(); seen = None
+    while time.time() - t0 < timeout:
+        s = dev.status()
+        if s["running"] and s["stage"] == "os" and s["kbd"] and s["uptime"] >= 70:
+            return s
+        if (s["stage"], int(s["uptime"] // 30)) != seen:
+            seen = (s["stage"], int(s["uptime"] // 30)); log(f"  waiting for the desktop: stage={s['stage']} uptime={s['uptime']:.0f}s")
+        time.sleep(5)
+    raise RuntimeError("Windows did not reach the desktop")
+
+
+def bench(dev, tag, seconds, log):
+    dev.push(os.path.join(HERE, "bench.ps1"), "Documents/Shared/bench.ps1")
+    dev.push_text(f"{tag} {seconds}\n", "Documents/Shared/bench_cfg.txt")
+    dev.push_text("pending\n", "Documents/Shared/bench_result.txt")
+    samples = []
+    for attempt in (1, 2):
+        dev.push_text('!powershell -ExecutionPolicy Bypass -c "irm http://10.0.2.4/bench.ps1 | iex"', "Documents/type.request")
+        t_typed = time.time()
+        while time.time() - t_typed < seconds + 110:
+            s = dev.status(); samples.append((time.time(), s))
+            res = dev.pull("Documents/Shared/bench_result.txt", os.path.join(dev.out, "_result.txt"))
+            if f"tag={tag}" in res and "finished=" in res:
+                return dict(l.strip().split("=", 1) for l in res.splitlines() if "=" in l), samples, time.time()
+            time.sleep(3)
+        log("  no result from the guest; typing the command once more")
+    raise RuntimeError("the guest benchmark never reported")
+
+
+def host_fps(samples, t_end, seconds):
+    """Frames the app presented per second of guest uptime, inside the benchmark window."""
+    win = [s for t, s in samples if t_end - seconds - 4 <= t <= t_end - 2]
+    pts = sorted({(s["uptime"], s["frames"]) for s in win})
+    if len(pts) < 2 or pts[-1][0] <= pts[0][0]: return None, None
+    idle = [s["idle"] for s in win]
+    return (pts[-1][1] - pts[0][1]) / (pts[-1][0] - pts[0][0]), sum(idle) / len(idle)
+
+
+def parse_console(path, start_off, end_off, dsym):
+    text = open(path, errors="replace").read()[start_off:end_off]
+    dumps, cur = [], None
+    for l in text.splitlines():
+        m = re.match(r"hvprof: (\d+) samples, idle ([\d.]+)%, of busy: jit ([\d.]+)%, other images ([\d.]+)%", l)
+        if m:
+            cur = {"busy": float(m[1]) * (1 - float(m[2]) / 100), "idle": float(m[2]), "jit": float(m[3]), "oth": float(m[4]),
+                   "host": [], "other": [], "threads": []}
+            dumps.append(cur); continue
+        if not cur: continue
+        m = re.match(r"hvprof:\s+([\d.]+)% \+(0x[0-9a-f]+)", l)
+        if m: cur["host"].append((float(m[1]), int(m[2], 16))); continue
+        m = re.match(r"hvprof: other\s+([\d.]+)% (\S+)", l)
+        if m: cur["other"].append((float(m[1]), m[2])); continue
+        if l.startswith("hvprof: threads"): cur["threads"] = [float(x) for x in re.findall(r"\] ([\d.]+)%", l)]
+    out = {"dumps": len(dumps)}
+    stats = re.findall(r"^stats.*$", text, re.M)
+    def avg(pat):
+        v = [float(m[1]) for s in stats for m in [re.search(pat, s)] if m]
+        return sum(v) / len(v) if v else None
+    out.update(exc_per_s=avg(r"exc (\d+)/s"), irq_per_s=avg(r"irq (\d+)/s"), translated_per_s=avg(r"translated (\d+)/s"),
+               translate_pct=avg(r"; (\d+)% of time"))
+    if not dumps: return out
+    tot = sum(d["busy"] for d in dumps) or 1
+    out["jit_pct"] = sum(d["jit"] * d["busy"] for d in dumps) / tot
+    out["other_pct"] = sum(d["oth"] * d["busy"] for d in dumps) / tot
+    nt = max(len(d["threads"]) for d in dumps)
+    out["cpu_busy"] = [sum(d["threads"][i] for d in dumps if len(d["threads"]) > i) / len(dumps) for i in range(nt)]
+    agg, oth = collections.Counter(), collections.Counter()
+    for d in dumps:
+        for pct, off in d["host"]: agg[off] += pct / 100 * d["busy"]
+        for pct, name in d["other"]: oth[name] += pct / 100 * d["busy"]
+    fn = collections.Counter()
+    offs = sorted(agg, key=lambda o: -agg[o])
+    if offs and os.path.exists(dsym):
+        names = run(["atos", "-o", dsym, "-arch", "arm64", "-l", "0x100000000"] + [hex(0x100000000 + o) for o in offs]).stdout.strip().split("\n")
+        for o, s in zip(offs, names): fn[re.sub(r" \(in .*", "", s)] += agg[o]
+    out["host_top"] = [(f, round(100 * n / tot, 1)) for f, n in fn.most_common(8)]
+    out["other_top"] = [(f, round(100 * n / tot, 1)) for f, n in oth.most_common(6)]
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--udid", default="YOUR_IPAD_UDID")
+    ap.add_argument("--coredevice", default="YOUR_COREDEVICE_ID")
+    ap.add_argument("--bundle", default="your.bundle.id")
+    ap.add_argument("--seconds", type=int, default=40)
+    ap.add_argument("--only", nargs="*")
+    ap.add_argument("--out", default=os.path.join(HERE, "results", time.strftime("%Y%m%d-%H%M%S")))
+    ap.add_argument("--dsym", default=os.path.join(ROOT, "build/DerivedData-iPad/Build/Products/Release-iphoneos/WindowsiOS.app.dSYM/Contents/Resources/DWARF/WindowsiOS"))
+    a = ap.parse_args()
+    os.makedirs(a.out, exist_ok=True)
+    dev = Device(a)
+    logf = open(os.path.join(a.out, "run.log"), "a")
+    def log(msg):
+        line = time.strftime("%H:%M:%S ") + msg
+        print(line, flush=True); logf.write(line + "\n"); logf.flush()
+    results = []
+    for tag, desc, env, args in CONFIGS:
+        if a.only and tag not in a.only: continue
+        log(f"[{tag}] {desc}")
+        rec = {"tag": tag, "desc": desc}
+        proc = None
+        try:
+            proc, console = start_app(dev, tag, env, args, log)
+            s = wait_desktop(dev, log)
+            log(f"  desktop up (uptime {s['uptime']:.0f}s, 3d={s['three_d']}, scanout {s['scanout']}); settling 40 s")
+            time.sleep(40)
+            off0 = os.path.getsize(console)
+            guest, samples, t_end = bench(dev, tag, a.seconds, log)
+            off1 = os.path.getsize(console)
+            fps, idle = host_fps(samples, t_end, a.seconds)
+            last = samples[-1][1]
+            rec.update(guest=guest, host_fps=fps, host_idle_pct=idle, ram_mb=last["ram"], three_d=last["three_d"],
+                       scanout=last["scanout"], jit_used_mb=last["jit_used"], jit_full_flushes=last["flushes"],
+                       prof=parse_console(console, off0, off1, a.dsym))
+            log(f"  guest {guest.get('steps_per_s')} steps/s, worst gap {guest.get('worst_step_ms')} ms; host {fps and round(fps, 1)} fps")
+        except Exception as e:
+            rec["error"] = str(e); log("  FAILED: " + str(e))
+        results.append(rec)
+        json.dump(results, open(os.path.join(a.out, "results.json"), "w"), indent=1, ensure_ascii=False)
+    log("done: " + os.path.join(a.out, "results.json"))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/bench/vk_matrix.sh b/scripts/bench/vk_matrix.sh
new file mode 100644
index 0000000..dcd6f63
--- /dev/null
+++ b/scripts/bench/vk_matrix.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+# vkmark under several host settings, each in a fresh app start (Arch on the iPad):
+#   vk_matrix.sh 'name={"ENV":"value",...}' ...     -> one line per run: name score score
+# The guest needs /root/gb1.sh (scripts/arch/gb1.sh).
+cd "$(dirname "$0")/../.."
+export ARCH_DEV_DIR=${ARCH_DEV_DIR:-/tmp/archdev}
+for spec in "$@"; do
+    name=${spec%%=*}; envj=${spec#*=}
+    ARCH_ENV="$envj" scripts/arch_dev.sh boot >/dev/null
+    sleep 150
+    s=""
+    for i in 1 2; do
+        out=$(scripts/arch_job.sh "bash /root/gb1.sh vk m$i" 300)
+        s="$s $(echo "$out" | grep -o 'Score: [0-9]*' | awk '{print $2}')"
+        [ -z "$(echo "$out" | grep -o 'Score')" ] && s="$s fail"
+    done
+    echo "$name$s"
+done
diff --git a/scripts/build_arch_image.py b/scripts/build_arch_image.py
new file mode 100644
index 0000000..8df55ff
--- /dev/null
+++ b/scripts/build_arch_image.py
@@ -0,0 +1,276 @@
+#!/usr/bin/env python3
+"""Builds a bootable Arch Linux ARM disk for WindowsiOS from the official rootfs tarball.
+
+  python3 scripts/build_arch_image.py ArchLinuxARM-aarch64-latest.tar.gz OUTDIR [--size-gib 10]
+
+The machine boots it the way it boots Windows: EDK2 UEFI -> systemd-boot -> the Arch kernel, with
+ACPI describing the board. The disk:
+  GPT  1: ESP, FAT32, 512 MiB, mounted at /boot: systemd-boot, kernel Image, initramfs, loader entries
+       2: root, ext4, the rest
+Root logs in by itself on the screen (tty1); the kernel and boot messages also go to the serial
+port, which the app writes to Documents/winvm.log.
+
+Needs Homebrew's e2fsprogs (mke2fs, debugfs) and mtools (mformat, mcopy). The ext4 file system is
+filled through debugfs from the tarball itself, so Linux owners, modes, symlinks, hard links and
+file capabilities survive although macOS file systems cannot hold them.
+Writes OUTDIR/disk.img (raw), then packs it to OUTDIR/windows11.hvsparse for the app's importer.
+"""
+import argparse, os, shutil, struct, subprocess, sys, tarfile, uuid, zlib
+
+E2 = '/opt/homebrew/opt/e2fsprogs/sbin'
+MT = '/opt/homebrew/bin'
+MiB = 1 << 20
+SECTOR = 512
+
+ESP_TYPE = uuid.UUID('C12A7328-F81F-11D2-BA4B-00A0C93EC93B')
+LINUX_ROOT_ARM64 = uuid.UUID('B921B045-1DF0-41C3-AF44-4C6F280D3FAE')
+
+
+def run(*a, **kw):
+    r = subprocess.run(a, capture_output=True, text=True, **kw)
+    if r.returncode:
+        sys.exit(f'{a[0]} failed ({r.returncode}):\n{r.stdout[-2000:]}\n{r.stderr[-2000:]}')
+    return r
+
+
+def write_gpt(f, disk_bytes, parts):
+    """parts: [(type uuid, part uuid, first lba, last lba, name)]"""
+    nsec = disk_bytes // SECTOR
+    entries = bytearray(128 * 128)
+    for i, (t, u, first, last, name) in enumerate(parts):
+        struct.pack_into('<16s16sQQQ72s', entries, i * 128, t.bytes_le, u.bytes_le, first, last, 0,
+                         name.encode('utf-16le'))
+    ecrc = zlib.crc32(entries)
+    disk_guid = uuid.uuid4()
+
+    def header(cur, backup, entries_lba):
+        h = bytearray(92)
+        struct.pack_into('<8sIIIIQQQQ16sQIII', h, 0, b'EFI PART', 0x00010000, 92, 0, 0, cur, backup,
+                         34, nsec - 34, disk_guid.bytes_le, entries_lba, 128, 128, ecrc)
+        struct.pack_into('<I', h, 16, zlib.crc32(h))
+        return bytes(h) + bytes(SECTOR - 92)
+
+    mbr = bytearray(SECTOR)  # protective MBR
+    mbr[446:462] = struct.pack('<BBBBBBBBII', 0, 0, 2, 0, 0xEE, 0xFF, 0xFF, 0xFF, 1, min(nsec - 1, 0xFFFFFFFF))
+    mbr[510:512] = b'\x55\xaa'
+    f.seek(0); f.write(mbr)
+    f.write(header(1, nsec - 1, 2)); f.write(entries)
+    f.seek((nsec - 33) * SECTOR); f.write(entries)
+    f.write(header(nsec - 1, 1, nsec - 33))
+
+
+def q(p):
+    if '"' in p or '\n' in p:
+        raise ValueError(p)
+    return '"' + p + '"'
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('tarball'); ap.add_argument('out')
+    ap.add_argument('--size-gib', type=int, default=10)
+    ap.add_argument('--hostname', default='archios')
+    a = ap.parse_args()
+    os.makedirs(a.out, exist_ok=True)
+    stage = os.path.join(a.out, 'stage'); shutil.rmtree(stage, ignore_errors=True)
+    files_dir = os.path.join(stage, 'files'); esp_dir = os.path.join(stage, 'esp')
+    os.makedirs(files_dir); os.makedirs(os.path.join(esp_dir, 'EFI', 'BOOT')); os.makedirs(os.path.join(esp_dir, 'loader', 'entries'))
+
+    disk_bytes = a.size_gib << 30
+    esp_first, esp_bytes = MiB, 512 * MiB
+    root_first = esp_first + esp_bytes
+    root_bytes = disk_bytes - root_first - MiB  # room for the backup GPT
+    esp_uuid, root_uuid, fs_uuid = uuid.uuid4(), uuid.uuid4(), uuid.uuid4()
+
+    cmdline = (f'root=PARTUUID={root_uuid} rw rootwait console=ttyAMA0,115200 console=tty0 '
+               f'loglevel=4 systemd.show_status=1')
+    here = os.path.dirname(os.path.abspath(__file__))  # scripts/
+    overlays = {
+        './etc/hostname': f'{a.hostname}\n',
+        './etc/fstab': ('# <device>  <dir>  <type>  <options>  <dump> <pass>\n'
+                        f'PARTUUID={esp_uuid}  /boot  vfat  defaults,nofail,x-systemd.device-timeout=15s  0 2\n'),
+        './etc/systemd/system/getty@tty1.service.d/autologin.conf':
+            '[Service]\nExecStart=\nExecStart=-/sbin/agetty -o \'-p -f -- \\\\u\' --noclear --autologin root %I $TERM\n',
+        './etc/motd': ('\nArch Linux ARM on WindowsiOS\n'
+                       '  root logs in by itself on this screen. Users: root/root, alarm/alarm.\n'
+                       '  Before the first pacman -Syu:  pacman-key --init && pacman-key --populate archlinuxarm\n'
+                       '  /boot is the EFI partition (kernel and boot loader).\n\n'),
+        # Suit the emulator's translator (see scripts/arch/jit_tune.sh): no address randomization, so
+        # libraries keep their addresses from process to process and their translated code is reused,
+        # and a 160 MB stack limit, which keeps stack and library pages apart in its 64 MB software TLB.
+        './etc/sysctl.d/90-winios-jit.conf': 'kernel.randomize_va_space = 0\n',
+        './etc/systemd/system.conf.d/90-winios-stack.conf': '[Manager]\nDefaultLimitSTACK=160M:infinity\n',
+        './etc/systemd/user.conf.d/90-winios-stack.conf': '[Manager]\nDefaultLimitSTACK=160M:infinity\n',
+        './etc/security/limits.d/90-winios-stack.conf': '*    soft stack 163840\nroot soft stack 163840\n',
+        # Grows the root partition and file system at boot when the app made the disk bigger.
+        './usr/local/sbin/winios-growroot': open(os.path.join(here, 'arch', 'growroot', 'winios-growroot')).read(),
+        './etc/systemd/system/winios-growroot.service':
+            open(os.path.join(here, 'arch', 'growroot', 'winios-growroot.service')).read(),
+    }
+    executables = {'./usr/local/sbin/winios-growroot'}
+    extra_symlinks = {'./etc/systemd/system/multi-user.target.wants/winios-growroot.service':
+             '/etc/systemd/system/winios-growroot.service'}
+    created_dirs = {'./etc/systemd/system/getty@tty1.service.d', './etc/systemd/system.conf.d',
+                    './etc/systemd/user.conf.d', './etc/sysctl.d', './etc/security/limits.d',
+                    './usr/local/sbin', './etc/systemd/system/multi-user.target.wants'}
+
+    cmds = []
+    dir_bytes = {}  # directory -> bytes its entries need (debugfs's ln and symlink do not grow a full directory)
+    dir_at = {}     # directory -> index in cmds just after its mkdir
+
+    def entry(path):
+        parent = os.path.dirname(path) or '/'
+        dir_bytes[parent] = dir_bytes.get(parent, 24) + 8 + (len(os.path.basename(path)) + 3) // 4 * 4
+    links = {}      # hard link target -> extra names
+    seen = set()
+    n_files = 0
+
+    def meta(path, m, mode_type):
+        cmds.append(f'sif {q(path)} mode 0{mode_type | (m.mode & 0o7777):o}')
+        cmds.append(f'sif {q(path)} uid {m.uid}')
+        cmds.append(f'sif {q(path)} gid {m.gid}')
+
+    print('reading', a.tarball, flush=True)
+    t = tarfile.open(a.tarball, 'r:gz')
+    for m in t:
+        name = m.name if m.name.startswith('./') else './' + m.name.lstrip('/')
+        name = name.rstrip('/') or '.'
+        path = '/' if name == '.' else name[1:]
+        if name.startswith('./boot/') and name.count('/') > 2:  # device trees: unused (ACPI describes the board)
+            continue
+        if name.startswith('./boot/') and m.isfile():      # the kernel and initramfs go to the ESP
+            with open(os.path.join(esp_dir, os.path.basename(name)), 'wb') as o:
+                shutil.copyfileobj(t.extractfile(m), o)
+            continue
+        if name.startswith('./boot/') and m.isdir():
+            continue
+        if path != '/': entry(path)
+        if m.isdir():
+            if path != '/': cmds.append(f'mkdir {q(path)}')
+            meta(path, m, 0o040000)
+            dir_at[path] = len(cmds)
+        elif m.issym():
+            cmds.append(f'symlink {q(path)} {q(m.linkname)}')
+            cmds.append(f'sif {q(path)} uid {m.uid}'); cmds.append(f'sif {q(path)} gid {m.gid}')
+        elif m.islnk():
+            target = '/' + (m.linkname[2:] if m.linkname.startswith('./') else m.linkname.lstrip('/'))
+            cmds.append(f'ln {q(target)} {q(path)}')
+            links[target] = links.get(target, 1) + 1
+        elif m.isfile():
+            data = overlays.pop(name, None)
+            src = os.path.join(files_dir, f'{n_files // 2000}', f'{n_files}')
+            os.makedirs(os.path.dirname(src), exist_ok=True)
+            with open(src, 'wb') as o:
+                if data is not None: o.write(data.encode())
+                else: shutil.copyfileobj(t.extractfile(m), o)
+            n_files += 1
+            if name == './usr/lib/systemd/boot/efi/systemd-bootaa64.efi':  # also the ESP's boot loader
+                shutil.copy(src, os.path.join(esp_dir, 'EFI', 'BOOT', 'BOOTAA64.EFI'))
+            cmds.append(f'write {q(src)} {q(path)}')
+            meta(path, m, 0o100000)
+            for k, v in m.pax_headers.items():
+                if k.startswith('SCHILY.xattr.'):
+                    xf = src + '.xattr'
+                    with open(xf, 'wb') as o: o.write(v.encode('utf-8', 'surrogateescape'))
+                    cmds.append(f'ea_set -f {q(xf)} {q(path)} {k[len("SCHILY.xattr."):]}')
+        else:
+            print('skipped (type %r):' % m.type, name)
+        seen.add(name)
+    for target, count in links.items():
+        cmds.append(f'sif {q(target)} links_count {count}')
+    # files the tarball did not have
+    for name, data in overlays.items():
+        d = os.path.dirname(name)
+        if d in created_dirs:
+            parts = d[2:].split('/')
+            for i in range(1, len(parts) + 1):
+                sub = './' + '/'.join(parts[:i])
+                if sub not in seen:
+                    cmds.append(f'mkdir {q(sub[1:])}'); cmds.append(f'sif {q(sub[1:])} mode 040755'); seen.add(sub)
+        src = os.path.join(files_dir, f'extra{len(cmds)}')
+        with open(src, 'w') as o: o.write(data)
+        cmds.append(f'write {q(src)} {q(name[1:])}')
+        mode = '0100755' if name in executables else '0100644'
+        cmds.append(f'sif {q(name[1:])} mode {mode}'); cmds.append(f'sif {q(name[1:])} uid 0'); cmds.append(f'sif {q(name[1:])} gid 0')
+    for name, target in extra_symlinks.items():
+        d = os.path.dirname(name)
+        if d not in seen:
+            cmds.append(f'mkdir {q(d[1:])}'); cmds.append(f'sif {q(d[1:])} mode 040755'); seen.add(d)
+        cmds.append(f'symlink {q(name[1:])} {q(target)}')
+    # grow every directory up front to hold all its entries
+    grow = {}
+    for d, nbytes in dir_bytes.items():
+        extra = -(-nbytes // 3800) - 1
+        if extra > 0 and d in dir_at: grow.setdefault(dir_at[d], []).extend([f'expand_dir {q(d)}'] * extra)
+    out = []
+    for i, c in enumerate(cmds):
+        out.extend(grow.get(i, []))
+        out.append(c)
+    out.extend(grow.get(len(cmds), []))
+    print(f'{sum(len(v) for v in grow.values())} directory blocks added up front', flush=True)
+    cmds = out
+    script = os.path.join(stage, 'debugfs.cmd')
+    with open(script, 'w') as o: o.write('\n'.join(cmds) + '\n')
+    print(f'{n_files} files, {len(cmds)} debugfs commands', flush=True)
+
+    # ESP contents
+    if not os.path.exists(os.path.join(esp_dir, 'EFI', 'BOOT', 'BOOTAA64.EFI')): sys.exit('systemd-boot missing from the tarball')
+    with open(os.path.join(esp_dir, 'loader', 'loader.conf'), 'w') as o:
+        o.write('default arch.conf\ntimeout 0\nconsole-mode keep\n')
+    with open(os.path.join(esp_dir, 'loader', 'entries', 'arch.conf'), 'w') as o:
+        o.write(f'title   Arch Linux ARM\nlinux   /Image\ninitrd  /initramfs-linux.img\noptions {cmdline}\n')
+    for need in ('Image', 'initramfs-linux.img'):
+        if not os.path.exists(os.path.join(esp_dir, need)): sys.exit(f'{need} missing from the tarball')
+
+    # root file system
+    root_img = os.path.join(a.out, 'root.img')
+    if os.path.exists(root_img): os.unlink(root_img)
+    print('mke2fs', flush=True)
+    run(f'{E2}/mke2fs', '-q', '-F', '-t', 'ext4', '-L', 'archroot', '-U', str(fs_uuid), '-E', 'lazy_itable_init=0,lazy_journal_init=0',
+        root_img, f'{root_bytes // 1024}k')
+    print('debugfs: filling the root file system (takes a while)', flush=True)
+    r = subprocess.run([f'{E2}/debugfs', '-w', '-f', script, root_img], capture_output=True, text=True)
+    errs = [l for l in r.stderr.splitlines() if l and not l.startswith('debugfs ') and 'Allocated inode' not in l]
+    open(os.path.join(a.out, 'debugfs.err'), 'w').write('\n'.join(errs))
+    print(f'debugfs exit {r.returncode}, {len(errs)} messages (debugfs.err)', flush=True)
+    r = subprocess.run([f'{E2}/e2fsck', '-fy', root_img], capture_output=True, text=True)
+    open(os.path.join(a.out, 'e2fsck.log'), 'w').write(r.stdout + r.stderr)
+    print('e2fsck exit', r.returncode, '(0: clean, 1: fixed)', flush=True)
+    if r.returncode > 1: sys.exit('e2fsck found errors it could not fix: see e2fsck.log')
+
+    # the disk
+    disk = os.path.join(a.out, 'disk.img')
+    print('assembling', disk, flush=True)
+    with open(disk, 'wb') as f:
+        f.truncate(disk_bytes)
+        write_gpt(f, disk_bytes, [
+            (ESP_TYPE, esp_uuid, esp_first // SECTOR, (esp_first + esp_bytes) // SECTOR - 1, 'EFI system'),
+            (LINUX_ROOT_ARM64, root_uuid, root_first // SECTOR, (root_first + root_bytes) // SECTOR - 1, 'Arch Linux ARM'),
+        ])
+        f.seek(root_first)
+        with open(root_img, 'rb') as r_:
+            while True:
+                b = r_.read(16 * MiB)
+                if not b: break
+                if b.count(0) == len(b): f.seek(len(b), 1)
+                else: f.write(b)
+    off = f'{disk}@@{esp_first}'
+    run(f'{MT}/mformat', '-i', off, '-F', '-T', str(esp_bytes // SECTOR), '-v', 'ESP', '::')
+    run(f'{MT}/mcopy', '-i', off, '-s', '-Q', *[os.path.join(esp_dir, x) for x in sorted(os.listdir(esp_dir))], '::/')
+    print(run(f'{MT}/mdir', '-i', off, '-/', '::').stdout[-1500:])
+    os.unlink(root_img)
+    print('esp', esp_uuid, 'root', root_uuid)
+    print('done:', disk)
+
+
+def find_member(tarball, member, dest):
+    t = tarfile.open(tarball, 'r:gz')
+    for m in t:
+        if m.name == member:
+            with open(dest, 'wb') as o: shutil.copyfileobj(t.extractfile(m), o)
+            return dest
+    sys.exit(member + ' not in the tarball')
+
+
+if __name__ == '__main__':
+    main()
